<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#f6f6f6;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f6;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;margin:24px 0;padding:32px;font-family:Arial,Helvetica,sans-serif;color:#222222;">
            <tr>
              <td>
                <p>Hi,</p>
                <p>Welcome to {{ app_name }} — your email is verified and your account is ready.</p>
                <p>{{ app_name }} removes visible marks from AI media you own, with a verifiable no-quality-loss report.</p>
                <p>
                  <a href="{{ base_url | safe }}/quickstart" style="display:inline-block;background:#1a73e8;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:4px;">Get started</a>
                </p>
                <p>Or copy this link into your browser:<br><a href="{{ base_url | safe }}/quickstart">{{ base_url | safe }}/quickstart</a></p>
                <p>— The {{ app_name }} team</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
