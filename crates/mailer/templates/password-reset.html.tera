<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#f6f6f6;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f6;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;margin:24px 0;padding:32px;font-family:Arial,Helvetica,sans-serif;color:#222222;">
            <tr>
              <td>
                <p>Hi,</p>
                <p>You asked to reset your {{ app_name }} password. Open the link below to choose a new one:</p>
                <p>
                  <a href="{{ base_url | safe }}/auth/reset-password?token={{ token }}" style="display:inline-block;background:#1a73e8;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:4px;">Reset my password</a>
                </p>
                <p>Or copy this link into your browser:<br><a href="{{ base_url | safe }}/auth/reset-password?token={{ token }}">{{ base_url | safe }}/auth/reset-password?token={{ token }}</a></p>
                <p>The link expires in 30 minutes and can only be used once. If you did not ask for a reset, you can ignore this email — your password is unchanged.</p>
                <p>— The {{ app_name }} team</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
