<!doctype html>
<html>
  <body style="margin:0;padding:0;background:#f6f6f6;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f6f6f6;">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;margin:24px 0;padding:32px;font-family:Arial,Helvetica,sans-serif;color:#222222;">
            <tr>
              <td>
                <p>Hi,</p>
                <p>Here's your week on {{ app_name }} (week starting {{ week_start }}).</p>
                <p>Images processed: {{ images_used }} of {{ images_limit }} for the week.<br>Video processed: {{ video_seconds_used }} of {{ video_seconds_limit }} seconds for the week.<br>Plan: {{ plan_code }}</p>
                <p>Tips for next week:</p>
                <ul>
{% for tip in tips %}                  <li>{{ tip }}</li>
{% endfor %}                </ul>
                <p>See your usage at <a href="{{ base_url | safe }}/billing">{{ base_url | safe }}/billing</a>, or upgrade any time at <a href="{{ base_url | safe }}/plans">{{ base_url | safe }}/plans</a>.</p>
                <p>— The {{ app_name }} team</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
