# Detag environment template (P0-011).
#
# Copy to `.env` for local dev: `cp .env.example .env`
# NEVER put real secrets here — placeholders only. `.env` itself is
# gitignored and must never be committed. The pre-commit hook and CI
# gitleaks scan enforce this; `just env-check` fails if this file drifts
# from the runbook table (docs/06-DELIVERY/03-deploy-runbook.md) or from
# PF_* vars referenced in code.
#
# Defaults below are safe for local dev only (localhost services, test
# keys, features off). Production values come from the deployment
# environment — see the runbook.

# --- Database / cache ---
PF_DATABASE_URL=postgres://pf:pf@localhost:5432/pf
PF_REDIS_URL=redis://localhost:6379

# --- Postgres (compose service, P0-034) ---
# Dev credentials for the compose postgres service; must match
# PF_DATABASE_URL above. Placeholders only — never real secrets.
PF_POSTGRES_USER=pf
PF_POSTGRES_PASSWORD=pf
PF_POSTGRES_DB=pf

# --- API ---
# IP the api binds on (P0-085). Loopback by default; compose sets
# 0.0.0.0 — inside a container 127.0.0.1 is the container's own
# loopback, unreachable from other containers or published ports.
PF_API_HOST=127.0.0.1
PF_API_PORT=8080
# IP the internal /metrics servers (api + worker) bind on (P0-085).
# Same rule as PF_API_HOST: loopback natively, 0.0.0.0 in compose.
PF_METRICS_HOST=127.0.0.1
PF_METRICS_PORT=9090
# Deployment environment: dev | stage | prod. Gates dev-only
# surfaces — the Swagger UI (/docs) is served in dev and stage
# only, never in prod (P0-067).
PF_ENVIRONMENT=dev

# --- Worker ---
# Apalis workers per queue (pipeline, cleanup, email,
# reconciliation) — each queue runs this many workers (P0-075).
PF_WORKER_CONCURRENCY=4
# Port the worker's internal /metrics server binds on 127.0.0.1 (P0-080).
PF_WORKER_METRICS_PORT=9092
# How often the worker writes its heartbeat row (P0-080): pid,
# queues, in-flight count, started_at. Must be >= 1.
PF_WORKER_HEARTBEAT_INTERVAL_SECS=15
# Graceful-drain bound (P0-081): after SIGTERM/SIGINT the worker
# finishes in-flight jobs for at most this long, then exits 1.
# Un-acked jobs re-queue via the visibility timeout (NFR-21).
PF_WORKER_DRAIN_TIMEOUT_SECS=30
# Redis key namespace for the queues (P0-081): `pf:queue:{queue}`.
# Point a test/staging worker at its own namespace so it never
# reads production jobs.
PF_WORKER_QUEUE_NAMESPACE=pf:queue
# Visibility timeout (NFR-21, P0-079): a dead worker's in-flight
# jobs are re-queued after this long without a keep-alive.
# PF_QUEUE_KEEP_ALIVE_SECS is the heartbeat interval — a live
# worker re-registers this often, so a long job on a live worker
# is never re-queued. Visibility must be > keep-alive.
PF_QUEUE_VISIBILITY_TIMEOUT_SECS=300
PF_QUEUE_KEEP_ALIVE_SECS=30

# --- Storage (S3-compatible; local MinIO defaults) ---
PF_S3_ENDPOINT=http://localhost:9000
PF_S3_BUCKET=detag-dev
PF_S3_ACCESS_KEY=minioadmin
PF_S3_SECRET_KEY=minioadmin
PF_S3_REGION=us-east-1
# Presigned PUT part URLs stay valid this long (seconds). Must stay
# under the 15-min access-token TTL (FR-A-02) — see PresignPolicy.
PF_UPLOAD_PART_URL_TTL_SECS=600

# --- Auth ---
# Dev-only fixed secret. Production requires a 64-byte random secret.
PF_JWT_SECRET=dev-fixed
PF_PUBLIC_BASE_URL=http://localhost:8080

# --- Billing (Stripe test mode; live keys are an owner action) ---
PF_STRIPE_SECRET_KEY=sk_test_placeholder
PF_STRIPE_WEBHOOK_SECRET=whsec_placeholder
PF_RAZORPAY_KEY=rzp_test_placeholder
PF_RAZORPAY_SECRET=placeholder
PF_FEATURE_RAZORPAY=false

# --- Email (MailHog in dev) ---
PF_SMTP_HOST=localhost
PF_SMTP_PORT=1025
PF_SMTP_USER=
PF_SMTP_PASS=
PF_MAIL_FROM=noreply@detag.local

# --- Engine ---
PF_ENGINE_MODELS_DIR=./models
PF_ENGINE_GPU=0
PF_ENGINE_TILES_MAX=1024

# --- Result retention (hours, by plan) ---
PF_RESULTS_TTL_FREE_H=6
PF_RESULTS_TTL_PRO_H=24
PF_RESULTS_TTL_BUSINESS_H=72

# --- Features ---
# Provenance strip stays OFF until the owner signs the legal-review gate
# (docs/02-REQUIREMENTS/05-compliance-aup.md).
PF_FEATURE_PROVENANCE_STRIP=false

# --- Observability ---
PF_LOG_LEVEL=info
PF_OTEL_ENDPOINT=

# --- Web console (CORS, P0-065) ---
# The single browser origin allowed to call the api cross-origin.
# Empty disables CORS entirely. Dev console: http://localhost:3000.
PF_WEB_ORIGIN=

# --- Tests (not runtime settings) ---
# Live MinIO leg of the storage integration suite (P0-061): 1 runs it
# against a testcontainers MinIO (CI); empty skips it (dev default).
PF_TEST_LIVE_MINIO=
# Testcontainers leg of the api integration suite (harness.rs): 1 runs
# it against real postgres/redis containers (CI); empty skips it
# (dev default — DOCKER-001, no docker on this VM).
PF_TEST_CONTAINERS=
