  "query": "SELECT id, user_id, reporter_contact, job_id, reason, status,\n                  resolution, notes, created_at, updated_at, resolved_at,\n                  resolved_by\n           FROM abuse_reports\n           WHERE user_id = $1 AND status = 'open' AND created_at >= $2\n           ORDER BY created_at DESC, id DESC\n           LIMIT 1",
