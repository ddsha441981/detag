  "query": "SELECT id, user_id, refresh_hash, family_id, device,\n                  expires_at, revoked_at, replaced_by, last_seen, created_at\n           FROM sessions\n           WHERE user_id = $1 AND revoked_at IS NULL AND expires_at > $2\n           ORDER BY created_at DESC, id DESC",
