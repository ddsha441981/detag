{
  "db_name": "PostgreSQL",
  "query": "SELECT id, user_id, upload_id, text_version, ip_hash, client,\n                      created_at, velocity_count AS \"velocity_count!\"\n               FROM (\n                   SELECT id, user_id, upload_id, text_version, ip_hash, client,\n                          created_at,\n                          COALESCE(COUNT(*) OVER (\n                              PARTITION BY user_id\n                              ORDER BY created_at\n                              RANGE BETWEEN INTERVAL '24 hours' PRECEDING\n                                        AND CURRENT ROW\n                          ), 0) AS velocity_count\n                   FROM attestations\n               ) AS w\n               WHERE ($1::boolean IS NULL OR (velocity_count > $2) = $1)\n               ORDER BY date_trunc('milliseconds', created_at) DESC, id DESC\n               LIMIT $3",
